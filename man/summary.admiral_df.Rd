\subsection{Summarizing a computed BDS parameter}{

\if{html}{\out{<div class="sourceCode r">}}\preformatted{library(tibble)

advs <- tribble(
  ~USUBJID,      ~PARAMCD, ~AVAL, ~AVISIT,
